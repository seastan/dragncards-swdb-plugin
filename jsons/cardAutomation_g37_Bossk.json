{
    "functions": {
        "TRIGGER_BOSSK": {
            "args": ["$CARD", "$DESTROYED_CARD"],
            "code": [
                ["COND",
                    ["EQUAL", "$DESTROYED_CARD.groupId", "sharedGalaxyRow"],
                    [
                        ["LOG", "└── Bossk's ability triggered: Gain 1 force."],
                        ["GAIN_N_FORCE", "$CARD.controller", 1],
                        ["FADE_TEXT_PLAYER", "$CARD.controller", "+1 force"]
                    ]
                ]
            ]
        }
    }
}
