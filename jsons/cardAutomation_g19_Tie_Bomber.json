{
    "automation": {
        "cards": {
            "g19": {
                "_comment": "Tie Bomber",
                "ability": {
                    "A": [
                        ["COND",
                            ["ABILITY_UNUSED", "$THIS"],
                            [
                                ["LOG", "{{$ALIAS_N}} triggered Tie Bomber's ability: Discard 1 card from the galaxy row."],
                                ["PROMPT", "$THIS.controller", "g19_discard", "$THIS"]
                            ],
                            ["TRUE"],
                            ["LOG", "{{$ALIAS_N}} tried to use Tie Bomber's ability but it cannot be activated."]
                        ]
                    ]
                }
            }
        }
    },
    "prompts": {
        "g19_discard": {
            "args": ["$CARD"],
            "message": "Select a card from the galaxy row to discard.",
            "input": {
                "type": "selectCards",
                "autoSubmit": {
                    "numCards": 1,
                    "code": [
                        ["VAR", "$TARGET_CARD_ID", "$PROMPT_INPUT.[0]"],
                        ["VAR", "$TARGET_CARD", "$GAME.cardById.{{$TARGET_CARD_ID}}"],
                        ["COND",
                            ["NOT_EQUAL", "$TARGET_CARD.groupId", "sharedGalaxyRow"],
                            ["LOG", "└── Selected card is not in the galaxy row."],
                            ["TRUE"],
                            [
                                ["LOG", "└── Discarded {{$TARGET_CARD.currentFace.name}} from the galaxy row."],
                                ["MOVE_FROM_GALAXY_ROW", "$TARGET_CARD.id", "sharedGalaxyDiscard"],
                                ["SET", "/cardById/$CARD.id/rotation", -20]
                            ]
                        ]
                    ]
                }
            },
            "options": [
                {
                    "label": "Cancel"
                }
            ]
        }
    }
}
