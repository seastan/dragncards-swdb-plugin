{
    "automation": {
        "cards": {
            "cw_scs1": {
                "_comment": "Munificent-class Frigate",
                "ability": {
                    "A": [
                        ["COND",
                            ["ABILITY_UNUSED", "$THIS"],
                            [
                                ["LOG", "└── {{$ALIAS_N}} triggered Munificent-class Frigate's ability: Exile a Separatist card from the galaxy row to repair 2 damage."],
                                ["PROMPT", "$THIS.controller", "cw_scs1_exile", "$THIS"]
                            ],
                            ["TRUE"],
                            ["LOG", "{{$ALIAS_N}} tried to use Munificent-class Frigate's ability but it cannot be activated."]
                        ]
                    ]
                }
            }
        }
    },
    "prompts": {
        "cw_scs1_exile": {
            "args": ["$CARD"],
            "message": "Select a Separatist card from the galaxy row to exile. If you do, repair 2 damage from your base.",
            "input": {
                "type": "selectCards",
                "autoSubmit": {
                    "numCards": 1,
                    "code": [
                        ["VAR", "$TARGET_CARD_ID", "$PROMPT_INPUT.[0]"],
                        ["VAR", "$TARGET_CARD", "$GAME.cardById.{{$TARGET_CARD_ID}}"],
                        ["COND",
                            ["NOT_EQUAL", "$TARGET_CARD.groupId", "sharedGalaxyRow"],
                            ["LOG", "└── Selected card is not in the galaxy row."],
                            ["NOT_EQUAL", "$TARGET_CARD.currentFace.faction", "Separatist"],
                            ["LOG", "└── Selected card is not a Separatist card."],
                            ["TRUE"],
                            [
                                ["LOG", "└── Exiled {{$TARGET_CARD.currentFace.name}} and repaired 2 damage."],
                                ["MOVE_FROM_GALAXY_ROW", "$TARGET_CARD_ID", "sharedExiled"],
                                ["REPAIR_DAMAGE", "$CARD.controller", 2],
                                ["SET", "/cardById/$CARD.id/rotation", -20]
                            ]
                        ]
                    ]
                }
            },
            "options": [
                {
                    "label": "Cancel",
                    "code": [
                        ["SET", "/cardById/$CARD.id/rotation", -20]
                    ]
                }
            ]
        }
    }
}
