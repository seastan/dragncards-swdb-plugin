{
    "automation": {
        "cards": {
            "cw_g43": {
                "_comment": "Protocol Droid",
                "ability": {
                    "A": [
                        ["COND",
                            ["AND",
                                ["ABILITY_UNUSED", "$THIS"],
                                ["GROUP_NOT_EMPTY", "sharedGalaxyDeck"]
                            ],
                            [
                                ["VAR", "$CONTROLLER", "$THIS.controller"],
                                ["VAR", "$PLAYER_FACTION", ["GET_FACTION", "$CONTROLLER"]],
                                ["EXILE_CARD", "$THIS"],
                                ["VAR", "$TOP_CARD", "$GAME.groupById.sharedGalaxyDeck.parentCards.[0]"],
                                ["LOG", "└── Discarded {{$TOP_CARD.sides.A.name}}."],
                                ["MOVE_CARD", "$TOP_CARD.id", "sharedGalaxyDiscard", 0],
                                ["WHILE",
                                    ["AND",
                                        ["GROUP_NOT_EMPTY", "sharedGalaxyDeck"],
                                        ["NOT_EQUAL", "$TOP_CARD.sides.A.faction", "$PLAYER_FACTION"]
                                    ],
                                    [
                                        ["UPDATE_VAR", "$TOP_CARD", "$GAME.groupById.sharedGalaxyDeck.parentCards.[0]"],
                                        ["LOG", "└── Discarded {{$TOP_CARD.sides.A.name}}."],
                                        ["MOVE_CARD", "$TOP_CARD.id", "sharedGalaxyDiscard", 0]
                                    ]
                                ],
                                ["COND",
                                    ["EQUAL", "$TOP_CARD.sides.A.faction", "$PLAYER_FACTION"],
                                    [
                                        ["LOG", "└── Found {{$PLAYER_FACTION}} card: {{$TOP_CARD.sides.A.name}}."],
                                        ["PROMPT", "$CONTROLLER", "protocolDroid_chooseGalaxyRowCard", "$THIS", "$TOP_CARD"]
                                    ],
                                    ["TRUE"],
                                    ["LOG", "└── Protocol Droid: No {{$PLAYER_FACTION}} card found in the galaxy deck."]
                                ]
                            ],
                            ["TRUE"],
                            ["LOG", "{{$ALIAS_N}} tried to use Protocol Droid's ability but it cannot be activated."]
                        ]
                    ]
                }
            }
        }
    },
    "prompts": {
        "protocolDroid_chooseGalaxyRowCard": {
            "args": ["$ABILITY_CARD", "$TOP_CARD"],
            "message": "Protocol Droid: Select a neutral unit in the galaxy row to replace with the faction card on top of the galaxy deck.",
            "input": {
                "type": "selectCards",
                "autoSubmit": {
                    "numCards": 1,
                    "code": [
                        ["VAR", "$TARGET_ID", "$PROMPT_INPUT.[0]"],
                        ["VAR", "$TARGET_CARD", "$GAME.cardById.{{$TARGET_ID}}"],
                        ["COND",
                            ["NOT_EQUAL", "$TARGET_CARD.groupId", "sharedGalaxyRow"],
                            [
                                ["LOG", "└── Selected card is not in the galaxy row."],
                                ["PROMPT", "$ABILITY_CARD.controller", "protocolDroid_chooseGalaxyRowCard", "$ABILITY_CARD", "$TOP_CARD"]
                            ],
                            ["NOT_EQUAL", "$TARGET_CARD.sides.A.faction", "Neutral"],
                            [
                                ["LOG", "└── Selected card is not neutral."],
                                ["PROMPT", "$ABILITY_CARD.controller", "protocolDroid_chooseGalaxyRowCard", "$ABILITY_CARD", "$TOP_CARD"]
                            ],
                            ["NOT_EQUAL", "$TARGET_CARD.sides.A.type", "Unit"],
                            [
                                ["LOG", "└── Selected card is not a unit."],
                                ["PROMPT", "$ABILITY_CARD.controller", "protocolDroid_chooseGalaxyRowCard", "$ABILITY_CARD", "$TOP_CARD"]
                            ],
                            ["TRUE"],
                            [
                                ["LOG", "└── Replacing {{$TARGET_CARD.sides.A.name}} with {{$TOP_CARD.sides.A.name}}."],
                                ["MOVE_CARD", "$TOP_CARD.id", "sharedGalaxyRow", "$TARGET_CARD.stackIndex"],
                                ["MOVE_CARD", "$TARGET_ID", "sharedGalaxyDiscard", 0]]
                            ]
                        ]
                }
            },
            "options": [
                {
                    "label": "There are no neutral units in the galaxy row",
                    "code": ["LOG", "└── No neutral units in the galaxy row to replace."]
                }
            ]
        }
    }
}
