{
    "automation": {
        "cards": {
            "cw_g37": {
                "_comment": "Jar Jar Binks",
                "rules": {
                    "entersPlay": {
                        "_comment": "When you play Jar Jar Binks, you may spend 2 resources to gain 1 force and place him in your opponent's discard pile.",
                        "type": "entersPlay",
                        "side": "A",
                        "then": [
                            ["LOG", "└── Jar Jar Binks's ability triggered."],
                            ["PROMPT", "$PLAYER_N", "cw_g37_choice", "$THIS_ID"]
                        ]
                    }
                }
            }
        }
    },
    "prompts": {
        "cw_g37_choice": {
            "args": ["$CARD_ID"],
            "message": "Jar Jar Binks: Spend 2 resources to gain 1 force and place him in your opponent's discard pile?",
            "options": [
                {
                    "label": "Spend 2 resources",
                    "hotkey": "1",
                    "code": [
                        ["VAR", "$CARD", "$GAME.cardsById.$CARD_ID"],
                        ["COND",
                            ["GREATER_THAN", "$GAME.playerData.{{$CARD.controller}}.resources", 1],
                            [
                                ["LOG", "└── Spent 2 resources. Gained 1 force. Placed Jar Jar in opponent's discard."],
                                ["DECREASE_VAL", "/playerData/{{$CARD.controller}}/resources", 2],
                                ["GAIN_N_FORCE", "$CARD.controller", 1],
                                ["VAR", "$OPPONENT", ["NEXT_PLAYER", "$CARD.controller"]],
                                ["MOVE_CARD", "$CARD.id", "{{$OPPONENT}}Discard", 0]
                            ],
                            ["TRUE"],
                            ["LOG", "└── Not enough resources to pay for Jar Jar Binks's ability."]
                        ]
                    ]
                },
                {
                    "label": "Skip",
                    "hotkey": "2"
                }
            ]
        }
    }
}
