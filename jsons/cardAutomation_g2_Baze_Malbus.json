{
    "automation": {
        "cards": {
            "g2": {
                "_comment": "Baze Malbus",
                "rules": {
                    "victoryPileBonus": {
                        "_comment": "Baze Malbus gains 1 [attack] for each Rebel base in your opponent's victory pile.",
                        "type": "trigger",
                        "listenTo": ["/groupById"],
                        "condition": ["TRUE"],
                        "then": [
                            ["VAR", "$OPPONENT", "player2"],
                            ["COND",
                                ["EQUAL", "$THIS.controller", "player2"],
                                ["UPDATE_VAR", "$OPPONENT", "player1"]
                            ],
                            ["VAR", "$REBEL_BASE_COUNT", 0],
                            ["FOR_EACH_KEY_VAL", "$CARD_ID", "$CARD", "$GAME.cardById", [
                                ["COND",
                                    ["AND",
                                        ["EQUAL", "$CARD.groupId", "{{$OPPONENT}}VictoryDisplay"],
                                        ["EQUAL", "$CARD.currentFace.type", "Base"],
                                        ["EQUAL", "$CARD.currentFace.faction", "Rebel"]
                                    ],
                                    ["INCREASE_VAR", "$REBEL_BASE_COUNT", 1]
                                ]
                            ]],
                            ["VAR", "$CURRENT_BONUS", "$GAME.cardById.$THIS.id.tokens.bazeMalbusBonus"],
                            ["COND",
                                ["NOT_EQUAL", "$CURRENT_BONUS", "$REBEL_BASE_COUNT"],
                                [
                                    ["VAR", "$BONUS_CHANGE", ["SUBTRACT", "$REBEL_BASE_COUNT", "$CURRENT_BONUS"]],
                                    ["INCREASE_VAL", "/cardById/$THIS.id/tokens/attackModifier", "$BONUS_CHANGE"],
                                    ["SET", "/cardById/$THIS.id/tokens/bazeMalbusBonus", "$REBEL_BASE_COUNT"]
                                ]
                            ]
                        ]
                    }
                }
            }
        }
    }
}
