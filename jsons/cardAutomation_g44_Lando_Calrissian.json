{
    "automation": {
        "cards": {
            "g44": {
                "_comment": "Lando Calrissian",
                "ability": {
                    "A": [
                        ["COND",
                            ["ABILITY_UNUSED", "$THIS"],
                            [
                                ["LOG", "{{$ALIAS_N}} triggered Lando Calrissian's ability: Draw 1 card."],
                                ["DRAW_CARD", 1, "$PLAYER_N"],
                                ["COND",
                                    ["IS_FORCE_WITH_YOU", "$PLAYER_N"],
                                    [
                                        ["VAR", "$OPPONENT", ["NEXT_PLAYER", "$PLAYER_N"]],
                                        ["LOG", "└── The Force is with you, so opponent discards 1 card."],
                                        ["PROMPT", "$OPPONENT", "g44_discard", "$THIS"]
                                    ]
                                ],
                                ["SET", "/cardById/$THIS.id/rotation", -20]
                            ],
                            ["TRUE"],
                            ["LOG", "{{$ALIAS_N}} tried to use Lando Calrissian's ability but it cannot be activated."]
                        ]
                    ]
                }
            }
        }
    },
    "prompts": {
        "g44_discard": {
            "args": ["$CARD"],
            "message": "Select a card from your hand to discard.",
            "input": {
                "type": "selectCards",
                "autoSubmit": {
                    "numCards": 1,
                    "code": [
                        ["VAR", "$DISCARD_CARD_ID", "$PROMPT_INPUT.[0]"],
                        ["VAR", "$DISCARD_CARD", "$GAME.cardById.{{$DISCARD_CARD_ID}}"],
                        ["COND",
                            ["NOT_EQUAL", "$DISCARD_CARD.groupId", "{{$PLAYER_N}}Hand"],
                            ["LOG", "└── Selected card is not in your hand."],
                            ["TRUE"],
                            [
                                ["LOG", "└── Discarded {{$DISCARD_CARD.currentFace.name}}."],
                                ["DISCARD_CARD_ID", "$DISCARD_CARD_ID"],
                                ["SET", "/cardById/$CARD.id/rotation", -20]
                            ]
                        ]
                    ]
                }
            }
        }
    }
}
