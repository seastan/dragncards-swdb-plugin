{
    "automation": {
        "cards": {
            "rb5": {
                "_comment": "Alderaan",
                "rules": {
                    "revealedGainResources": {
                        "_comment": "When you reveal Alderaan, gain 4 resources.",
                        "type": "entersPlay",
                        "side": "A",
                        "then": [
                            ["LOG", "└── Alderaan's ability: Gain 4 resources."],
                            ["INCREASE_VAL", "/playerData/{{$THIS.controller}}/resources", 4],
                            ["FADE_TEXT_PLAYER", "$THIS.controller", "+4 token:resource"]
                        ]
                    }
                }
            }
        }
    }
}
