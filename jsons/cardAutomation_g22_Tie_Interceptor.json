{
    "automation": {
        "cards": {
            "g22": {
                "_comment": "Tie Interceptor",
                "ability": {
                    "A": [
                        ["COND",
                            ["ABILITY_UNUSED", "$THIS"],
                            [
                                ["COND",
                                    ["GROUP_NOT_EMPTY", "sharedGalaxyDeck"],
                                    [
                                        ["VAR", "$TOP_CARD", "$GAME.groupById.sharedGalaxyDeck.parentCards.[0]"],
                                        ["LOG", "{{$ALIAS_N}} triggered Tie Interceptor's ability: Revealed {{$TOP_CARD.currentFace.name}}."],
                                        ["COND",
                                            ["EQUAL", "$TOP_CARD.currentFace.faction", "Empire"],
                                            [
                                                ["LOG", "└── It is an Empire card, drew 1 card."],
                                                ["DRAW_CARD", 1, "$THIS.controller"]
                                            ],
                                            ["EQUAL", "$TOP_CARD.currentFace.faction", "Rebel"],
                                            [
                                                ["LOG", "└── It is an enemy card, discarding it."],
                                                ["MOVE_CARD", "$TOP_CARD.id", "sharedGalaxyDiscard", 0]
                                            ]
                                        ]
                                    ]
                                ],
                                ["SET", "/cardById/$THIS.id/rotation", -20]
                            ],
                            ["TRUE"],
                            ["LOG", "{{$ALIAS_N}} tried to use Tie Interceptor's ability but it cannot be activated."]
                        ]
                    ]
                }
            }
        }
    }
}
