{
    "functions": {
        "GOT_PURCHASED": {
          "args": ["$CARD"],
          "code": [
            ["VAR", "$PLAYER_BASE", ["GET_BASE", "$PLAYER_N"]],
            ["VAR", "$DESTINATION", "{{$PLAYER_N}}Discard"],
            ["COND",
              ["EQUAL", "$CARD.sides.A.name", "Fang Fighter"],
              ["TRIGGER_FANG_FIGHTER", "$CARD"],

              ["EQUAL", "$CARD.sides.A.name", "Quarren Mercenary"],
              ["TRIGGER_QUARREN_MERCENARY", "$CARD"],

              ["EQUAL", "$CARD.sides.A.name", "Super Commando"],
              ["TRIGGER_SUPER_COMMANDO", "$CARD"],

              ["EQUAL", "$CARD.sides.A.name", "Vulture Droid"],
              ["TRIGGER_VULTURE_DROID", "$CARD"],

              ["EQUAL", "$CARD.sides.A.name", "Protectorate Fighter"],
              ["TRIGGER_PROTECTORATE_FIGHTER", "$CARD"],

              ["EQUAL", "$CARD.sides.A.name", "Jar Jar Binks"],
              ["PROMPT", "$PLAYER_N", "cw_g37_choice", "$CARD.id"],

              ["EQUAL", "$GAME.playerData.$PLAYER_N.nextPurchaseOnTopOfDeck", true],
              [
                ["LOG", "\u2514\u2500\u2500 Placing on top of deck."],
                ["UPDATE_VAR", "$DESTINATION", "{{$PLAYER_N}}Deck"],
                ["SET", "/playerData/$PLAYER_N/nextPurchaseOnTopOfDeck", false]
              ],

              ["AND",
                ["IN_STRING", "$CARD.currentFace.traits", "Droid."],
                "$GAME.playerData.$PLAYER_N.nextDroidPurchaseOnTopOfDeck"
              ],
              [
                ["LOG", "\u2514\u2500\u2500 Droid goes to top of deck due to previous card effect."],
                ["UPDATE_VAR", "$DESTINATION", "{{$PLAYER_N}}Deck"],
                ["SET", "/playerData/$PLAYER_N/nextDroidPurchaseOnTopOfDeck", false]
              ],

              ["AND",
                "$GAME.playerData.$PLAYER_N.nextBountyHunterOrTrooperPurchaseToHand",
                ["OR",
                  ["IN_STRING", "$CARD.currentFace.traits", "Bounty Hunter."],
                  ["IN_STRING", "$CARD.currentFace.traits", "Trooper."]
                ]
              ],
              [
                ["LOG", "\u2514\u2500\u2500 {{$CARD.currentFace.name}} goes to hand due to previous card effect."],
                ["UPDATE_VAR", "$DESTINATION", "{{$PLAYER_N}}Hand"],
                ["SET", "/playerData/$PLAYER_N/nextBountyHunterOrTrooperPurchaseToHand", false]
              ],

              "$GAME.playerData.$PLAYER_N.nextPurchaseToHand",
              [
                ["LOG", "\u2514\u2500\u2500 {{$CARD.currentFace.name}} goes to hand due to previous card effect."],
                ["UPDATE_VAR", "$DESTINATION", "{{$PLAYER_N}}Hand"],
                ["SET", "/playerData/$PLAYER_N/nextPurchaseToHand", false]
              ],

              ["AND",
                ["EQUAL", "$PLAYER_BASE.sides.A.name", "Sullust"],
                ["EQUAL", "$PLAYER_BASE.abilityUsedThisTurn", false]
              ],
              [
                ["LOG", "\u2514\u2500\u2500 {{$ALIAS_N}} triggered Sullust's ability: First purchase this turn goes on top of deck."],
                ["UPDATE_VAR", "$DESTINATION", "{{$PLAYER_N}}Deck"],
                ["SET", "/cardById/{{$PLAYER_BASE.id}}/abilityUsedThisTurn", true]
              ],

              ["AND",
                ["EQUAL", "$PLAYER_BASE.sides.A.name", "Jedha"],
                ["EQUAL", "$CARD.currentFace.faction", "Neutral"],
                ["EQUAL", "$PLAYER_BASE.abilityUsedThisTurn", false]
              ],
              ["TRIGGER_JEDHA_ABILITY", "$PLAYER_BASE", "$CARD"]
            ],
            ["SET", "/playerData/$PLAYER_N/purchasedCardThisTurn", true],
            ["COND",
              ["EQUAL", "$CARD.currentFace.faction", "Neutral"],
              ["SET", "/playerData/$PLAYER_N/purchasedNeutralCardThisTurn", true]
            ],
            ["COND",
              ["EQUAL", "$CARD.groupId", "sharedGalaxyRow"],
              ["MOVE_FROM_GALAXY_ROW", "$CARD.id", "$DESTINATION"],
              ["TRUE"],
              ["MOVE_CARD", "$CARD.id", "$DESTINATION", 0]
            ],
            ["FOR_EACH_KEY_VAL", "$HID", "$H", "$GAME.cardById",
              [["COND",
                ["AND",
                  "$H.inPlay",
                  ["EQUAL", "$H.controller", "$PLAYER_N"],
                  ["EQUAL", "$H.databaseId", "cw_g35"],
                  ["DEFINED", "$CARD.currentFace.cost"],
                  ["GREATER_EQUAL", "$CARD.currentFace.cost", 4]
                ],
                [
                  ["LOG", "\u2514\u2500\u2500 Hondo Ohnaka: draw 1 card for purchasing a card costing 4 or more."],
                  ["DRAW_CARD", 1, "$PLAYER_N"]
                ]
              ]]
            ],
            ["COND",
              "$GAME.playerData.$PLAYER_N.drawIfForceNeutralOnNextPurchase",
              [
                ["COND",
                  ["EQUAL", "$GAME.trackerValue", 0],
                  [
                    ["LOG", "\u2514\u2500\u2500 Force is neutral: drawing 1 card."],
                    ["DRAW_CARD", 1, "$PLAYER_N"]
                  ]
                ],
                ["SET", "/playerData/$PLAYER_N/drawIfForceNeutralOnNextPurchase", false]
              ]
            ]
          ]
        }
    }
}
