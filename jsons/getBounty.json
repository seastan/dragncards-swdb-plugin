                        ["LOG", "└── Reward: {{$ALIAS_N}} may exile up to 2 cards."],
                        ["EXILE_UP_TO_N_FROM_HAND_OR_DISCARD", "$PLAYER_N", 2]
                    ],
                    ["EQUAL", "$NAME", "Princess Leia"],
