{
    "functions": {
        "GET_BOUNTY": {
            "args": ["$CARD"],
            "code": [
                ["VAR", "$NAME", "$CARD.currentFace.name"],
                ["COND",
                    ["EQUAL", "$CARD.currentFace.faction", "Neutral"],
                    [
                        ["VAR", "$COST", "$CARD.currentFace.cost"],
                        ["LOG", "└── Reward: {{$ALIAS_N}} gained {{$COST}} resources."],
                        ["INCREASE_VAL", "/playerData/{{$PLAYER_N}}/resources", "$COST"],
                        ["FADE_TEXT_PLAYER", "$PLAYER_N", "+{{$COST}} token:resource"]
                    ],

                    ["EQUAL", "$NAME", "Y-Wing"],
                    [
                        ["LOG", "└── Reward: {{$ALIAS_N}} gained 1 resource."],
                        ["INCREASE_VAL", "/playerData/{{$PLAYER_N}}/resources", 1],
                        ["FADE_TEXT_PLAYER", "$PLAYER_N", "+1 token:resource"]
                    ],
                    ["EQUAL", "$NAME", "U-Wing"],
                    [
                        ["LOG", "└── Reward: {{$ALIAS_N}} gained 4 resources."],
                        ["INCREASE_VAL", "/playerData/{{$PLAYER_N}}/resources", 4],
                        ["FADE_TEXT_PLAYER", "$PLAYER_N", "+4 token:resource"]
                    ],
                    ["EQUAL", "$NAME", "Han Solo"],
                    [
                        ["LOG", "└── Reward: {{$ALIAS_N}} gained 3 resources and 2 force."],
                        ["INCREASE_VAL", "/playerData/{{$PLAYER_N}}/resources", 3],
                        ["FADE_TEXT_PLAYER", "$PLAYER_N", "+3 token:resource"],
                        ["GAIN_N_FORCE", "$PLAYER_N", 2]
                    ],
                    ["EQUAL", "$NAME", "Cassian Andor"],
