{
    "automation": {
        "cards": {
            "g20": {
                "_comment": "Scout Trooper",
                "ability": {
                    "A": [
                        ["COND",
                            ["ABILITY_UNUSED", "$THIS"],
                            [
                                ["VAR", "$DECK_SIZE", ["LENGTH", "$GAME.groupById.sharedGalaxyDeck.stackIds"]],
                                ["COND",
                                    ["GREATER_THAN", "$DECK_SIZE", 0],
                                    [
                                        ["VAR", "$TOP_CARD_ID", "$GAME.groupById.sharedGalaxyDeck.stackIds.[0]"],
                                        ["VAR", "$TOP_CARD", "$GAME.cardById.{{$TOP_CARD_ID}}"],
                                        ["LOG", "└── {{$ALIAS_N}} triggered Scout Trooper's ability: Revealed {{$TOP_CARD.sides.A.name}}."],
                                        ["COND",
                                            ["EQUAL", "$TOP_CARD.sides.A.faction", "Empire"],
                                            [
                                                ["LOG", "└── It is an Empire card, gained 1 resource."],
                                                ["GAIN_N_RESOURCES", "$THIS.controller", 1]
                                            ],
                                            ["EQUAL", "$TOP_CARD.sides.A.faction", "Rebel"],
                                            [
                                                ["LOG", "└── It is an enemy card, discarding it."],
                                                ["MOVE_CARD", "$TOP_CARD_ID", "sharedGalaxyDiscard", 0]
                                            ]
                                        ]
                                    ]
                                ],
                                ["SET", "/cardById/$THIS.id/rotation", -20]
                            ],
                            ["TRUE"],
                            ["LOG", "{{$ALIAS_N}} tried to use Scout Trooper's ability but it cannot be activated."]
                        ]
                    ]
                }
            }
        }
    }
}
