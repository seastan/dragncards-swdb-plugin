{
    "automation": {
        "cards": {
            "mandalorian_hunter": {
                "_comment": "Mandalorian Hunter",
                "ability": {
                    "A": [
                        ["COND",
                            ["NOT", ["ABILITY_UNUSED", "$THIS"]],
                            ["LOG", "{{$ALIAS_N}} tried to use Mandalorian Hunter's ability but it cannot be activated."],

                            ["NOT", ["IS_FORCE_WITH_YOU", "$THIS.controller"]],
                            ["LOG", "└── Mandalorian Hunter's ability did nothing: the Force is not with you."],

                            ["TRUE"],
                            [
                                ["VAR", "$SPACES", "$GAME.trackerValue"],
                                ["COND",
                                    ["LESS_THAN", "$GAME.trackerValue", 0],
                                    ["UPDATE_VAR", "$SPACES", ["SUBTRACT", 0, "$GAME.trackerValue"]]
                                ],
                                ["LOG", "└── Mandalorian Hunter's ability: The Force marker moves {{$SPACES}} space(s) to the neutral space. Mandalorian Hunter gains {{$SPACES}} attack."],
                                ["SET_TRACKER_VALUE", 0],
                                ["INCREASE_VAL", "/cardById/{{$THIS.id}}/tokens/attackModifier", "$SPACES"],
                                ["FADE_TEXT_CARD", "$THIS.id", "+{{$SPACES}} token:attackModifier"],
                                ["SET", "/cardById/$THIS.id/rotation", -20]
                            ]
                        ]
                    ]
                }
            }
        }
    }
}
