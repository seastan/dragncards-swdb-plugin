{
    "automation": {
        "cards": {
            "cw_rcs3": {
                "_comment": "Venator-Class Destroyer",
                "rules": {
                    "passiveRule": {
                        "_comment": "While Venator-Class Destroyer is in play, each of your Fighter units gains 1 forceModifier.",
                        "type": "whileInPlay",
                        "side": "A",
                        "condition": ["TRUE"],
                        "listenTo": [],
                        "onDo": [
                            ["LOG", "└── Venator-Class Destroyer added 1 force to each of your Fighter units."],
                            ["FOR_EACH_KEY_VAL", "$TARGET_ID", "$TARGET", "$GAME.cardById", [
                                ["COND",
                                    ["AND",
                                        "$TARGET.inPlay",
                                        ["EQUAL", "$TARGET.controller", "$THIS.controller"],
                                        ["IN_STRING", "$TARGET.currentFace.traits", "Fighter."]
                                    ],
                                    [
                                        ["INCREASE_VAL", "/cardById/$TARGET_ID/tokens/forceModifier", 1]
                                    ]
                                ]
                            ]]
                        ],
                        "offDo": [
                            ["LOG", "└── Venator-Class Destroyer no longer adds 1 force to each of your Fighter units."],
                            ["FOR_EACH_KEY_VAL", "$TARGET_ID", "$TARGET", "$GAME.cardById", [
                                ["COND",
                                    ["AND",
                                        "$TARGET.inPlay",
                                        ["EQUAL", "$TARGET.controller", "$THIS.controller"],
                                        ["IN_STRING", "$TARGET.currentFace.traits", "Fighter."]
                                    ],
                                    [
                                        ["DECREASE_VAL", "/cardById/$TARGET_ID/tokens/forceModifier", 1]
                                    ]
                                ]
                            ]]
                        ]
                    },
                    "targetChangeRule": {
                        "_comment": "Add/remove forceModifier when Fighter units enter/leave play.",
                        "type": "whileInPlay",
                        "side": "A",
                        "condition": [
                            "AND",
                            "$TARGET.inPlay",
                            ["EQUAL", "$TARGET.controller", "$THIS.controller"],
                            ["NOT_EQUAL", "$THIS_ID", "$TARGET_ID"],
                            ["IN_STRING", "$TARGET.currentFace.traits", "Fighter."]
                        ],
                        "listenTo": ["/cardById/*/inPlay", "/cardById/*/currentSide"],
                        "onDo": [
                            "COND",
                            ["AND", "$THIS.inPlay"],
                            [
                                ["LOG", "└── Venator-Class Destroyer added 1 force to {{$TARGET.currentFace.name}}."],
                                ["INCREASE_VAL", "/cardById/$TARGET_ID/tokens/forceModifier", 1]
                            ]
                        ],
                        "offDo": [
                            "COND",
                            ["AND", "$THIS.inPlay"],
                            [
                                ["LOG", "└── Venator-Class Destroyer no longer adds 1 force to {{$TARGET.currentFace.name}}."],
                                ["DECREASE_VAL", "/cardById/$TARGET_ID/tokens/forceModifier", 1]
                            ]
                        ]
                    }
                }
            }
        }
    }
}
